# Copy values into an ignored repository-root .env. Never commit credentials.
MONGODB_URI=
MONGODB_DATABASE=
MEMORY_EMBEDDING_MODE=automated
# Optional; defaults to memory_automated_v2 or memory_explicit_v2.
MEMORY_VECTOR_INDEX=
VOYAGE_MODEL=voyage-4
VOYAGE_DIMENSIONS=1024
# Only required when MEMORY_EMBEDDING_MODE=explicit.
VOYAGE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

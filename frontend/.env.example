# Run the storage-injected WSGI service from PR #4 separately.
MEMORY_API_URL=http://127.0.0.1:8000
# Optional locally; set this to the same value as Fly's MEMORY_API_TOKEN in production.
MEMORY_API_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional absolute path to Python with the root project's dependencies installed.
# DASHBOARD_PYTHON=/absolute/path/to/.venv/bin/python

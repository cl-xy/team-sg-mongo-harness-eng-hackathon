        <mxCell id="legend-title" value="Architecture flow" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1240" y="52" width="520" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="106" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-1" value="&lt;b&gt;Ingest complaints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Read NYC 311 records through Socrata. Replay creation timestamps for the historical demonstration.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="106" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="190" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-2" value="&lt;b&gt;Maintain working context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Persist raw complaints, agent decisions and conversation history in short-term Atlas memory.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="190" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="274" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-3" value="&lt;b&gt;Reason with retrieved context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Strands uses OpenRouter models and Atlas Managed MCP tool calls, authenticated by a service account.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="274" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="358" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-4" value="&lt;b&gt;Consolidate memory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A size/time threshold starts an asynchronous LLM pass. Extract salient patterns and prune short-term memory.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="358" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="442" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-5" value="&lt;b&gt;Store durable patterns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Write patterns to the long-term collection. Atlas Automated Embeddings uses Voyage AI to embed them.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="442" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="526" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-6" value="&lt;b&gt;Retrieve relevant memory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Atlas Vector Search retrieves similar patterns for each new complaint; Atlas Search supports text queries.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="526" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="610" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-7" value="&lt;b&gt;Build higher-order patterns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Cluster related memories and retain relationships. Explicit graph versus vector proximity remains open.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="610" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="694" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-8" value="&lt;b&gt;Decay stale memory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Periodically reduce salience or prune unused patterns. Trigger and decay function remain open.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="694" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-9" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="778" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-9" value="&lt;b&gt;Learn from recurrence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Flag a systemic issue and recommend an upstream fix. Score subsequent cluster complaints and update trust.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="778" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-10" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="862" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-10" value="&lt;b&gt;Observe and demonstrate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Next.js dashboard shows context, memory and tool activity. Compare against a sliding-window baseline.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1292" y="862" width="475" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend-note" value="Proposed design from README.md. AWS reference-diagram styling; generic AWS4 icons represent the actual non-AWS services." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1242" y="963" width="522" height="65" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="Design decisions pending: framework confirmation, consolidation trigger, graph representation and decay rule.&lt;br&gt;Recurrence is an observed signal: a recommendation and a later drop do not establish intervention causality." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1120" height="48" as="geometry" />
        </mxCell>

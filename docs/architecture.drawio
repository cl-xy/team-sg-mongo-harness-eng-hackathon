          <mxGeometry x="840" y="790" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="decay" value="&lt;b&gt;Periodic decay&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reduce salience of unused memories&lt;br&gt;Deprioritise or prune stale patterns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="atlas" value="&lt;b&gt;MONGODB ATLAS · required hackathon sandbox&lt;/b&gt;&lt;br&gt;&lt;br&gt;Short-term and long-term collections; automated embeddings and search indexes" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#0f172a;" vertex="1" parent="1">

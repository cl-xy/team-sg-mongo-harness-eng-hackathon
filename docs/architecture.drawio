        </mxCell>
        <mxCell id="consolidate" value="&lt;b&gt;Asynchronous consolidation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Extract salient patterns&lt;br&gt;Write long-term patterns&lt;br&gt;Prune short-term memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="570" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="long" value="&lt;b&gt;Long-term memory&lt;/b&gt;&lt;br&gt;&lt;br&gt;Embedded pattern documents&lt;br&gt;Higher-order cluster nodes and edges&lt;br&gt;Voyage AI Automated Embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="550" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="search" value="&lt;b&gt;Atlas Vector Search + Search&lt;/b&gt;&lt;br&gt;&lt;br&gt;Similarity retrieval per new complaint&lt;br&gt;Keyword / full-text queries as needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">

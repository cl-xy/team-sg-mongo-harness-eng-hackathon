        </mxCell>
        <mxCell id="output" value="&lt;b&gt;Systemic issue + recommendation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cluster-level upstream fix&lt;br&gt;Recommendation does not establish&lt;br&gt;that an intervention was executed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">

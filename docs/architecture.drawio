  <diagram id="02-evaluation" name="02 Evaluation">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;EVALUATION · DOES DURABLE MEMORY HELP?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compare both runs on timestamped NYC 311 complaint replay" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="replay" value="&lt;b&gt;Shared complaint replay&lt;/b&gt;&lt;br&gt;&lt;br&gt;Historical records delivered in timestamp order&lt;br&gt;Use matching input periods for both runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="160" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="baseline" value="&lt;b&gt;Run A · naive baseline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sliding-window context&lt;br&gt;Oldest turns dropped or summarised&lt;br&gt;No long-term memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="365" width="530" height="150" as="geometry" />
        </mxCell>
        <mxCell id="full" value="&lt;b&gt;Run B · proposed memory architecture&lt;/b&gt;&lt;br&gt;&lt;br&gt;Short-term → consolidation → long-term retrieval&lt;br&gt;Clustering / abstraction + decay&lt;br&gt;Durable patterns across days and weeks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="365" width="530" height="150" as="geometry" />
        </mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Compare surfaced systemic issues&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flagged clusters and recommended upstream fixes&lt;br&gt;Assess patterns that emerge beyond the immediate context window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="605" width="720" height="115" as="geometry" />
        </mxCell>
        <mxCell id="metric" value="&lt;b&gt;Primary signal · complaint recurrence rate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Observe new complaints in each flagged cluster over the following week.&lt;br&gt;Feed scores back into pattern trust, prioritisation and escalation.&lt;br&gt;Poor predictions lead to deprioritisation or pruning." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="800" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="caveat" value="&lt;b&gt;Measurement limitation&lt;/b&gt;&lt;br&gt;&lt;br&gt;A recommendation is not a verified intervention.&lt;br&gt;A later drop alone does not demonstrate causality.&lt;br&gt;Cluster definition and rate calculation remain unspecified." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="790" width="345" height="170" as="geometry" />
        </mxCell>
        <mxCell id="a" value="same input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="replay" target="baseline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b" value="same input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="replay" target="full">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d" value="issues + recommendations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="baseline" target="outputs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e" value="issues + recommendations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="full" target="outputs">

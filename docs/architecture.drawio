        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;Atlas Managed MCP Server&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agent read/write tool calls&lt;br&gt;Atlas service account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="350" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="short" value="&lt;b&gt;Short-term memory&lt;/b&gt;&lt;br&gt;&lt;br&gt;Raw complaints · decisions&lt;br&gt;Conversation history · working context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontSize=15;spacing=14;arcSize=12;" vertex="1" parent="1">
